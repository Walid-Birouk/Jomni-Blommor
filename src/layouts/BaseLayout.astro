---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import CursorTrail from '../components/CursorTrail.astro';
import { business } from '../data/business';
import { routes, defaultLang, t, type Lang, type RouteId } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteId;
  title: string;
  description: string;
  /** Set for pages that must not be indexed (404). */
  noindex?: boolean;
  /** Quieter page: no cursor petal trail (funerals). */
  calm?: boolean;
  ogImage?: string;
}

const { lang, route, title, description, noindex = false, calm = false, ogImage = '/og-image.jpg' } = Astro.props;
const site = Astro.site!;
// Until launch the whole site asks search engines not to index it (stock photos, placeholders).
// At launch set PUBLIC_ALLOW_INDEXING=true in Vercel and redeploy.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const canonical = new URL(routes[route][lang], site).href;
const alternates = (Object.keys(routes[route]) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(routes[route][l], site).href,
}));
const xDefault = new URL(routes[route][defaultLang], site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Structured data: only confirmed facts. TODO: add telephone,
// openingHoursSpecification, priceRange, sameAs and areaServed once confirmed.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Florist',
  name: business.name,
  url: new URL('/', site).href,
  image: ogImageUrl,
};
if (business.phoneE164) jsonLd.telephone = business.phoneE164;
if (business.email) jsonLd.email = business.email;
if (business.streetAddress && business.city) {
  jsonLd.address = {
    '@type': 'PostalAddress',
    streetAddress: business.streetAddress,
    postalCode: business.postalCode ?? undefined,
    addressLocality: business.city,
    addressCountry: 'SE',
  };
}
if (business.geo) {
  jsonLd.geo = { '@type': 'GeoCoordinates', ...business.geo };
}
if (business.mapUrl) jsonLd.hasMap = business.mapUrl;
if (business.social.length) jsonLd.sameAs = business.social.map((s) => s.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Arm scroll reveals only when motion is welcome; show everything if the reveal script never runs.
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('reveal');
          setTimeout(function () { if (!d.classList.contains('reveal-ready')) d.classList.remove('reveal'); }, 3000);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !allowIndexing) && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3e5b40" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCta lang={lang} />
    {!calm && <CursorTrail />}
    <script>import '../scripts/reveal';</script>
  </body>
</html>
