---
/**
 * Petals and leaves carried on the shared hero wind (src/scripts/wind.ts).
 * A gust blows them in on load, then they drift. The cursor pushes nearby petals
 * aside, and the bouquet sheds petals into this layer when brushed.
 * Decorative only (aria-hidden). Pausable (WCAG 2.2.2), stops off-screen and when
 * the tab is hidden, and draws a still frame for prefers-reduced-motion.
 */
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<canvas class="wind" aria-hidden="true"></canvas>
<button
  class="wind-toggle"
  type="button"
  data-label-pause={t(lang, 'wind.pause')}
  data-label-play={t(lang, 'wind.play')}
  hidden
>{t(lang, 'wind.pause')}</button>

<script>
  import { wind, onTick, onState, onEmit, setPaused, gustNow, startWind, isRunning } from '../scripts/wind';

  type Bit = {
    x: number; y: number; size: number; kind: 'petal' | 'leaf'; color: string;
    vy: number; kx: number; ky: number; rot: number; spin: number;
    flip: number; flipSpeed: number; sway: number; swaySpeed: number; depth: number; extra: boolean;
  };

  const PETALS = ['#9e2f4f', '#c25a78', '#e3a3b5', '#f1d5dc', '#fbfbf8'];
  const LEAVES = ['#3e5b40', '#5f7a5c', '#8a9a7b'];
  const STORE_KEY = 'jomni-wind-paused';
  const MAX_EXTRA = 24;
  const PUSH_RADIUS = 110;

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.wind');
  const toggle = document.querySelector<HTMLButtonElement>('.wind-toggle');
  const host = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');

  if (canvas && toggle && host && ctx) {
    let w = 0, h = 0, dpr = 1;
    let bits: Bit[] = [];
    // Areas with small text where petals fade so they never hurt legibility.
    let quiet: DOMRect[] = [];

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];

    const make = (fromLeft: boolean): Bit => {
      const kind = Math.random() < 0.7 ? 'petal' : 'leaf';
      const depth = rand(0.55, 1);
      return {
        x: fromLeft ? rand(-w * 0.3, -15) : rand(0, w),
        y: fromLeft ? rand(-h * 0.05, h * 0.75) : rand(-h * 0.6, h),
        size: rand(9, 17) * depth * (kind === 'leaf' ? 1.15 : 1),
        kind,
        color: kind === 'petal' ? pick(PETALS) : pick(LEAVES),
        vy: rand(18, 38) * depth,
        kx: 0, ky: 0,
        rot: rand(0, Math.PI * 2),
        spin: rand(-1.2, 1.2),
        flip: rand(0, Math.PI * 2),
        flipSpeed: rand(1.5, 3.5),
        sway: rand(0, Math.PI * 2),
        swaySpeed: rand(0.6, 1.4),
        depth,
        extra: false,
      };
    };

    const count = () => Math.round(Math.min(34, Math.max(14, (w * h) / 22000)));

    const resize = () => {
      const r = host.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      quiet = [...host.querySelectorAll<HTMLElement>('[data-wind-quiet]')].map((el) => {
        const q = el.getBoundingClientRect();
        return new DOMRect(q.left - r.left - 8, q.top - r.top - 8, q.width + 16, q.height + 16);
      });
      const base = bits.filter((b) => !b.extra);
      const extras = bits.filter((b) => b.extra);
      const n = count();
      while (base.length < n) base.push(make(false));
      base.length = n;
      bits = [...base, ...extras];
    };

    const drawBit = (b: Bit) => {
      const s = b.size;
      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.rotate(b.rot);
      // Tumbling: squash one axis so the bit seems to turn in 3D.
      ctx.scale(1, Math.max(0.15, Math.abs(Math.cos(b.flip))));
      const inQuiet = quiet.some((q) => b.x > q.left && b.x < q.right && b.y > q.top && b.y < q.bottom);
      ctx.globalAlpha = (0.55 + b.depth * 0.4) * (inQuiet ? 0.22 : 1);
      ctx.fillStyle = b.color;
      ctx.beginPath();
      if (b.kind === 'petal') {
        ctx.moveTo(0, -s);
        ctx.bezierCurveTo(s * 0.9, -s * 0.6, s * 0.7, s * 0.7, 0, s);
        ctx.bezierCurveTo(-s * 0.7, s * 0.7, -s * 0.9, -s * 0.6, 0, -s);
        ctx.fill();
        ctx.strokeStyle = 'rgb(30 42 36 / 0.12)';
        ctx.lineWidth = 0.6;
        ctx.stroke();
      } else {
        ctx.moveTo(0, -s * 1.3);
        ctx.quadraticCurveTo(s * 0.75, 0, 0, s * 1.3);
        ctx.quadraticCurveTo(-s * 0.75, 0, 0, -s * 1.3);
        ctx.fill();
        ctx.strokeStyle = 'rgb(243 244 239 / 0.45)';
        ctx.lineWidth = 0.7;
        ctx.beginPath();
        ctx.moveTo(0, -s * 1.1);
        ctx.lineTo(0, s * 1.1);
        ctx.stroke();
      }
      ctx.restore();
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const b of bits) drawBit(b);
    };

    onTick((dt) => {
      const g = wind.gust;
      const windX = wind.base + g;
      const hostRect = host.getBoundingClientRect();
      const p = wind.pointer;
      const px = p.x - hostRect.left, py = p.y - hostRect.top;
      const decay = Math.pow(0.12, dt);
      for (let i = bits.length - 1; i >= 0; i--) {
        const b = bits[i];
        b.sway += b.swaySpeed * dt;
        b.flip += b.flipSpeed * dt * (1 + g / 120);
        b.rot += b.spin * dt * (1 + g / 200);
        // Cursor effect: petals near the pointer are pushed out of its way.
        if (p.active) {
          const dx = b.x - px, dy = b.y - py;
          const d = Math.hypot(dx, dy);
          if (d < PUSH_RADIUS && d > 0.1) {
            const f = (1 - d / PUSH_RADIUS) * 1400 * dt;
            b.kx += (dx / d) * f + p.vx * 0.02 * (1 - d / PUSH_RADIUS);
            b.ky += (dy / d) * f;
            b.flip += f * 0.02;
          }
        }
        b.kx *= decay; b.ky *= decay;
        b.x += (windX * b.depth + Math.sin(b.sway) * 16 + b.kx) * dt;
        b.y += (b.vy + Math.cos(b.sway * 0.7) * 6 - g * 0.08 + b.ky) * dt;
        if (b.y > h + 30 || b.x > w + 40 || b.x < -w * 0.4 || b.y < -h * 0.7) {
          if (b.extra) { bits.splice(i, 1); continue; }
          Object.assign(b, make(Math.random() < 0.5));
          if (b.x >= 0) b.y = rand(-60, -15);
        }
      }
      draw();
    });

    // Petals shaken loose from the bouquet join the drift.
    onEmit((cx, cy, color) => {
      if (bits.filter((b) => b.extra).length >= MAX_EXTRA) return;
      const r = host.getBoundingClientRect();
      const b = make(false);
      Object.assign(b, {
        x: cx - r.left + rand(-6, 6), y: cy - r.top + rand(-6, 6),
        kind: 'petal', color, size: rand(10, 15), depth: rand(0.85, 1),
        kx: rand(-40, 80) + wind.pointer.vx * 0.05, ky: rand(-60, -10), extra: true,
      });
      bits.push(b);
    });

    onState(() => {
      if (wind.reduced) {
        // Reduced motion: a few petals resting where they fell, no movement.
        bits = bits.filter((b) => !b.extra);
        bits.forEach((b) => { b.flip = 0.4; });
        toggle.hidden = true;
      } else {
        toggle.hidden = false;
      }
      if (!isRunning()) draw();
      toggle.textContent = wind.paused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!;
    });

    toggle.addEventListener('click', () => {
      const value = !wind.paused;
      try { localStorage.setItem(STORE_KEY, value ? '1' : '0'); } catch { /* storage unavailable */ }
      setPaused(value);
    });

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); if (!isRunning()) draw(); }, 120);
    }).observe(host);

    const init = () => {
      resize();
      let paused = false;
      try { paused = localStorage.getItem(STORE_KEY) === '1'; } catch { paused = false; }
      wind.paused = paused;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!paused && !reduced) {
        // The opening gust: bits blow in from the left through the shop door.
        bits = bits.map((_, i) => (i % 3 === 0 ? make(false) : make(true)));
        gustNow(320);
      }
      startWind(host);
    };

    // Start after first paint so the hero stays fast.
    if ('requestIdleCallback' in window) requestIdleCallback(init, { timeout: 1200 });
    else setTimeout(init, 300);
  }
</script>

<style>
  .wind {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .wind-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-4);
    z-index: 3;
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    background: rgb(243 244 239 / 0.92);
    color: var(--color-text);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
  }
  .wind-toggle:hover { background: var(--white); }
  .wind-toggle[hidden] { display: none; }
</style>
