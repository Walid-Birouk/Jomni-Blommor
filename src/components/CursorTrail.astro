---
/**
 * Petals fall from the cursor as it moves, and a click gives a small burst.
 * Mouse and trackpad only (pointer: fine). Off for prefers-reduced-motion and
 * when the hero wind is paused. Decorative (aria-hidden), never blocks clicks.
 */
---

<canvas class="cursor-trail" aria-hidden="true"></canvas>

<script>
  import { wind } from '../scripts/wind';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.cursor-trail');
  const ctx = canvas?.getContext('2d');
  const fine = window.matchMedia('(pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    const COLORS = ['#9e2f4f', '#c25a78', '#e3a3b5', '#f1d5dc', '#8a9a7b'];
    const MAX = 40;
    type P = { x: number; y: number; vx: number; vy: number; s: number; rot: number; spin: number; flip: number; life: number; max: number; c: string };
    let ps: P[] = [];
    let raf = 0, last = 0, w = 0, h = 0;
    let lx = 0, ly = 0, travel = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const add = (x: number, y: number, vx: number, vy: number, s: number) => {
      if (ps.length >= MAX) ps.shift();
      ps.push({
        x, y, vx, vy, s,
        rot: rand(0, 6.28), spin: rand(-4, 4), flip: rand(0, 6.28),
        life: 0, max: rand(0.9, 1.5),
        c: COLORS[Math.floor(Math.random() * COLORS.length)],
      });
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
    };

    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, w, h);
      const breeze = (wind.base + wind.gust) * 0.6;
      ps = ps.filter((p) => (p.life += dt) < p.max);
      for (const p of ps) {
        p.vx += (breeze - p.vx) * 1.5 * dt;
        p.vy += 70 * dt;
        p.x += p.vx * dt; p.y += p.vy * dt;
        p.rot += p.spin * dt; p.flip += 5 * dt;
        const fade = Math.min(1, p.life * 8) * Math.min(1, (p.max - p.life) * 2.5);
        ctx.save();
        ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.scale(1, Math.max(0.2, Math.abs(Math.cos(p.flip))));
        ctx.globalAlpha = 0.9 * fade;
        ctx.fillStyle = p.c;
        ctx.beginPath();
        ctx.moveTo(0, -p.s);
        ctx.bezierCurveTo(p.s * 0.9, -p.s * 0.6, p.s * 0.7, p.s * 0.7, 0, p.s);
        ctx.bezierCurveTo(-p.s * 0.7, p.s * 0.7, -p.s * 0.9, -p.s * 0.6, 0, -p.s);
        ctx.fill();
        ctx.restore();
      }
      raf = ps.length ? requestAnimationFrame(frame) : 0;
    };

    const allowed = (e: PointerEvent) => e.pointerType === 'mouse' && fine.matches && !reduce.matches && !wind.paused;

    window.addEventListener('pointermove', (e) => {
      const dx = e.clientX - lx, dy = e.clientY - ly;
      lx = e.clientX; ly = e.clientY;
      if (!allowed(e)) return;
      travel += Math.hypot(dx, dy);
      // About one petal every 38px of movement, so slow movement stays calm.
      while (travel > 38) {
        travel -= 38;
        add(e.clientX + rand(-4, 4), e.clientY + rand(2, 8), dx * 0.8 + rand(-20, 20), rand(-10, 20), rand(6, 10));
      }
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      if (!allowed(e)) return;
      for (let i = 0; i < 9; i++) {
        const a = (i / 9) * Math.PI * 2 + rand(-0.3, 0.3);
        const v = rand(120, 220);
        add(e.clientX, e.clientY, Math.cos(a) * v, Math.sin(a) * v - 40, rand(7, 11));
      }
    }, { passive: true });
  }
</script>

<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 25;
    pointer-events: none;
  }
</style>
