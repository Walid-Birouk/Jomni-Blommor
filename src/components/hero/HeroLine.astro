---
/**
 * Hero variant B: photo prints hanging from a twine line with clothespins.
 * Each print swings around its pin on the shared wind; the cursor pushes them,
 * a tap sets them swinging. Still for prefers-reduced-motion.
 */
import type { Lang } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import HeroText from './HeroText.astro';
import WindPetals from '../WindPetals.astro';
import Photo from '../Photo.astro';
import p1 from '../../assets/stock/STOCK-bukett-hand.jpg';
import p2 from '../../assets/stock/STOCK-brudbukett.jpg';
import p3 from '../../assets/stock/STOCK-middagsbord-dahlior.jpg';
interface Props { lang: Lang; }
const { lang } = Astro.props;

// The twine sags as a curve; prints hang at three points along it (viewBox 600 x 120).
const y = (u: number) => (1 - u) ** 2 * 18 + 2 * (1 - u) * u * 166 + u ** 2 * 8;
const prints = [
  { src: p1, alt: t(lang, 'hero.alt.bouquet'), u: 0.17, w: 34, ratio: '4 / 5', rest: -3 },
  { src: p2, alt: t(lang, 'hero.alt.bridal'), u: 0.5, w: 29, ratio: '1 / 1', rest: 2 },
  { src: p3, alt: t(lang, 'hero.alt.table'), u: 0.82, w: 31, ratio: '3 / 4', rest: -1.5 },
].map((p) => ({ ...p, top: y(p.u) }));
---

<section class="hero-b container" aria-labelledby="hero-heading">
  <HeroText lang={lang} />
  <div class="hero-b__line">
    <svg class="hero-b__twine" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 18 Q300 166 600 8" fill="none" stroke="#a08a68" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
    {prints.map((p, i) => (
      <div
        class="print"
        style={`--u: ${p.u * 100}%; --top: ${p.top}px; --w: ${p.w}%; --rest: ${p.rest}deg; --i: ${i}`}
        data-print
        data-rest={p.rest}
      >
        <span class="print__pin" aria-hidden="true"></span>
        <div class="print__paper">
          <Photo src={p.src} alt={p.alt} lang={lang} ratio={p.ratio} sizes="(min-width: 48rem) 18vw, 34vw" widths={[240, 360, 540, 720]} eager={i === 0} />
        </div>
      </div>
    ))}
  </div>
  <WindPetals lang={lang} />
</section>

<script>
  import { wind, onTick, onState } from '../../scripts/wind';

  const prints = [...document.querySelectorAll<HTMLElement>('[data-print]')].map((el, i) => ({
    el, rest: Number(el.dataset.rest), a: Number(el.dataset.rest), v: 0, phase: i * 1.7, freq: 0.8 + i * 0.13,
  }));
  if (prints.length) {
    let time = 0;
    onState(() => { if (wind.reduced) prints.forEach((p) => { p.el.style.transform = ''; }); });
    onTick((dt) => {
      time += dt;
      const strength = Math.min((wind.base + wind.gust) / 120, 2.2);
      const pt = wind.pointer;
      for (const p of prints) {
        const r = p.el.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height * 0.6;
        let push = 0;
        if (pt.active) {
          const dx = cx - pt.x, dy = cy - pt.y, d = Math.hypot(dx, dy), R = 220;
          // Cursor effect: the print swings away from the pointer.
          if (d < R) push = (dx / R) * (1 - d / R) * 10 + pt.vx * 0.006 * (1 - d / R);
        }
        const target = p.rest + Math.sin(time * p.freq * 2 + p.phase) * 1.6 * (0.4 + strength * 0.6)
          + (wind.gust / 220) * 7 + Math.max(-14, Math.min(14, push));
        p.v += (24 * (target - p.a) - 3.2 * p.v) * dt;
        p.a += p.v * dt;
        p.el.style.transform = `translateX(-50%) rotate(${p.a.toFixed(2)}deg)`;
      }
    });
    document.querySelector('.hero-b__line')?.addEventListener('pointerdown', () => {
      if (wind.reduced || wind.paused) return;
      prints.forEach((p) => { p.v += (Math.random() - 0.3) * 120; });
    });
  }
</script>

<style>
  .hero-b {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--section-y);
  }
  .hero-b__line {
    position: relative;
    z-index: 0;
    height: clamp(17rem, 70vw, 24rem);
    margin-inline: calc(var(--gutter) * -1);
    touch-action: manipulation;
  }
  .hero-b__twine { position: absolute; inset: 0 0 auto 0; width: 100%; height: 120px; overflow: visible; }
  .print {
    position: absolute;
    left: var(--u);
    top: calc(var(--top) - 6px);
    width: var(--w);
    transform: translateX(-50%) rotate(var(--rest));
    transform-origin: 50% 0;
    will-change: transform;
  }
  .print__paper {
    padding: 6px 6px 18px;
    background: var(--white);
    box-shadow: 0 14px 28px -14px rgb(30 42 36 / 0.45), 0 2px 6px rgb(30 42 36 / 0.12);
  }
  .print__paper :global(.photo) { border-radius: 0; }
  .print__pin {
    position: absolute;
    left: 50%;
    top: -10px;
    z-index: 2;
    width: 9px;
    height: 26px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, #b99c72, #d9c3a0 45%, #b99c72);
    border-radius: 2px;
    box-shadow: 0 1px 2px rgb(30 42 36 / 0.3);
  }

  @media (min-width: 48rem) {
    .hero-b {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: var(--space-6);
      padding-top: var(--space-8);
      min-height: min(46rem, calc(100svh - 4rem));
    }
    .hero-b__line { height: 30rem; margin-inline: 0 calc(var(--gutter) * -1); }
  }
</style>
