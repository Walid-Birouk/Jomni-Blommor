---
/**
 * The hero: a line-drawn meadow the wind rolls through as a wave; the cursor parts the stems.
 * Phone: the meadow fills the first screen, with the headline, place and address over its
 * bottom on a birch fade. The rest of the words follow just below the first screen.
 * Desktop: the meadow sits behind the words, low on the left and tall on the right.
 * Arrival: the flowers grow up from the ground in a left-to-right wave (CSS, plays once).
 * Still for prefers-reduced-motion.
 */
import { business } from '../../data/business';
import { t, type Lang } from '../../i18n/utils';
import WindPetals from '../WindPetals.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const place = business.locality?.[lang];
const address = [business.streetAddress, business.district].filter(Boolean).join(', ');

// Deterministic random so the meadow is the same on every build.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const r = (a: number, b: number) => a + rnd() * (b - a);
const n = (v: number) => v.toFixed(1);

const INK = '#3e5b40';
type Stem = { x: number; h: number; svg: string; phase: number; delay: number };
const kinds = ['cosmos', 'tulip', 'umbel', 'bud', 'cosmos', 'grass', 'umbel', 'tulip'] as const;
const fills = { peony: '#9e2f4f', rose: '#c25a78', blush: '#e3a3b5', pale: '#f1d5dc', white: '#fbfbf8' };

const leafAt = (x: number, y: number, len: number, ang: number) =>
  `<path d="M${n(x)} ${n(y)} q${n(len * 0.35)} ${n(-len * 0.25)} ${n(len)} 0 q${n(-len * 0.45)} ${n(len * 0.3)} ${n(-len)} 0 Z" transform="rotate(${n(ang)} ${n(x)} ${n(y)})" fill="#dfe6d8" stroke="${INK}" stroke-width="1.3" vector-effect="non-scaling-stroke"/>`;

const head = (kind: string, x: number, y: number, s: number) => {
  if (kind === 'cosmos') {
    const c = [fills.blush, fills.pale, fills.rose, fills.white][Math.floor(r(0, 4))];
    let p = '';
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * 360;
      p += `<ellipse cx="${n(x)}" cy="${n(y - s * 0.55)}" rx="${n(s * 0.28)}" ry="${n(s * 0.55)}" transform="rotate(${a} ${n(x)} ${n(y)})" fill="${c}" fill-opacity="0.9" stroke="${INK}" stroke-width="1.1" vector-effect="non-scaling-stroke"/>`;
    }
    return p + `<circle cx="${n(x)}" cy="${n(y)}" r="${n(s * 0.2)}" fill="#c9a24a" stroke="${INK}" stroke-width="1.1" vector-effect="non-scaling-stroke"/>`;
  }
  if (kind === 'tulip') {
    const c = rnd() > 0.5 ? fills.peony : fills.rose;
    return `<path d="M${n(x - s * 0.5)} ${n(y - s * 0.2)} Q${n(x - s * 0.55)} ${n(y + s * 0.7)} ${n(x)} ${n(y + s * 0.7)} Q${n(x + s * 0.55)} ${n(y + s * 0.7)} ${n(x + s * 0.5)} ${n(y - s * 0.2)} L${n(x + s * 0.22)} ${n(y + s * 0.05)} L${n(x)} ${n(y - s * 0.45)} L${n(x - s * 0.22)} ${n(y + s * 0.05)} Z" fill="${c}" fill-opacity="0.92" stroke="${INK}" stroke-width="1.2" vector-effect="non-scaling-stroke"/>`;
  }
  if (kind === 'umbel') {
    let p = '';
    for (let i = 0; i < 9; i++) {
      const a = Math.PI * (1.1 + (i / 8) * 0.8);
      const ex = x + Math.cos(a) * s * 0.9, ey = y + Math.sin(a) * s * 0.7;
      p += `<path d="M${n(x)} ${n(y + s * 0.3)} L${n(ex)} ${n(ey)}" stroke="${INK}" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
      p += `<circle cx="${n(ex)}" cy="${n(ey)}" r="${n(s * 0.13)}" fill="${fills.white}" stroke="${INK}" stroke-width="0.9" vector-effect="non-scaling-stroke"/>`;
    }
    return p;
  }
  if (kind === 'bud') {
    return `<path d="M${n(x)} ${n(y - s * 0.7)} Q${n(x + s * 0.45)} ${n(y)} ${n(x)} ${n(y + s * 0.4)} Q${n(x - s * 0.45)} ${n(y)} ${n(x)} ${n(y - s * 0.7)} Z" fill="${fills.blush}" stroke="${INK}" stroke-width="1.2" vector-effect="non-scaling-stroke"/>`;
  }
  return '';
};

/**
 * Build one meadow. `height(t)` gives each stem's height as a share of H for its
 * position t (0 = left, 1 = right); `scale` sizes the flower heads.
 */
const meadow = (W: number, H: number, count: number, height: (t: number) => number, scale: number) => {
  const stems: Stem[] = [];
  for (let i = 0; i < count; i++) {
    const x = 16 + (i / (count - 1)) * (W - 32) + r(-10, 10);
    const t = x / W;
    const h = H * height(t);
    const kind = kinds[i % kinds.length];
    const bend = r(-30, 30);
    const tx = x + bend * 0.6, ty = H - h;
    let svg = `<path d="M${n(x)} ${H} Q${n(x + bend)} ${n(H - h * 0.55)} ${n(tx)} ${n(ty)}" fill="none" stroke="${INK}" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`;
    const leaves = kind === 'grass' ? 0 : Math.round(r(1, 3));
    for (let k = 0; k < leaves; k++) {
      const u = r(0.2, 0.6);
      const lx = x + (bend * 2 * (1 - u) * u) + (tx - x) * u * u;
      const ly = H - h * 0.55 * 2 * (1 - u) * u - h * u * u;
      svg += leafAt(lx, ly, r(20, 34) * scale, k % 2 ? r(-160, -120) : r(-60, -20));
    }
    if (kind === 'grass') {
      svg = `<path d="M${n(x)} ${H} Q${n(x + bend)} ${n(H - h * 0.5)} ${n(x + bend * 1.4)} ${n(H - h * 0.75)}" fill="none" stroke="${INK}" stroke-width="1.3" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`;
    } else {
      svg += head(kind, tx, ty, r(18, 28) * scale);
    }
    // Arrival: growth rolls left to right like the wind, with a little jitter.
    stems.push({ x, h, svg, phase: rnd() * 6.28, delay: Math.round(t * 450 + r(0, 120)) });
  }
  return stems;
};

// Desktop: low on the left where the words sit, tall on the right.
const DW = 1200, DH = 640;
const wide = meadow(DW, DH, 34, (t) => (t < 0.56 ? r(0.03, 0.07) : r(0.42, 0.86) * (0.7 + t * 0.35)), 1);
// Phone: a tall portrait meadow that fills the first screen; heads fill the upper part.
const PW = 400, PH = 640;
const narrow = meadow(PW, PH, 18, (t) => 0.5 + Math.sin(t * Math.PI * 2.4 + 0.4) * 0.14 + r(0, 0.26), 1.3);
---

<section class="hero-c" aria-labelledby="hero-heading">
  <div class="hero-c__meadow" aria-hidden="true">
    <svg class="meadow meadow--wide" viewBox={`0 0 ${DW} ${DH}`} preserveAspectRatio="xMaxYMax slice" focusable="false">
      {wide.map((s) => <g class="m-stem" data-x={s.x} data-h={s.h} data-phase={s.phase}><g class="m-grow" style={`--d: ${s.delay}ms`} set:html={s.svg} /></g>)}
      <path d={`M0 ${DH - 1} H${DW}`} stroke={INK} stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
    <svg class="meadow meadow--narrow" viewBox={`0 0 ${PW} ${PH}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      {narrow.map((s) => <g class="m-stem" data-x={s.x} data-h={s.h} data-phase={s.phase}><g class="m-grow" style={`--d: ${s.delay}ms`} set:html={s.svg} /></g>)}
      <path d={`M0 ${PH - 1} H${PW}`} stroke={INK} stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
  </div>

  <div class="hero-c__top" data-wind-quiet>
    <div class="container"><div class="hero-c__col">
      <!-- TODO: client copy -->
      <h1 id="hero-heading">{t(lang, 'home.hero.heading')}</h1>
      <p class="hero-c__place">
        {place ? t(lang, 'site.taglineCity', { place }) : <>{t(lang, 'site.tagline')} <em class="todo">{t(lang, 'todo.city')}</em></>}
      </p>
      <p class="hero-c__address">
        {business.streetAddress && business.mapUrl
          ? <a href={business.mapUrl}>{address}<span class="visually-hidden">{t(lang, 'hero.facts.mapSuffix')}</span></a>
          : <em class="todo">{t(lang, 'todo.address')}</em>}
      </p>
    </div></div>
  </div>

  <div class="hero-c__more" data-wind-quiet>
    <div class="container"><div class="hero-c__col">
      <!-- TODO: client copy -->
      <p class="hero-c__lead">{t(lang, 'home.hero.leadShort')}</p>
      <p class="hero-c__actions"><a class="btn btn--primary" href="#kontakt">{t(lang, 'cta.order')}</a></p>
      <ul class="hero-c__facts" aria-label={t(lang, 'hero.facts.label')}>
        <li>
          {t(lang, 'hero.facts.openToday')}{' '}
          {/* TODO: compute "Öppet idag till 18:30" from machine-readable hours once confirmed. */}
          <em class="todo">{t(lang, 'todo.hours')}</em>
        </li>
        <li>{t(lang, 'hero.facts.services')}</li>
      </ul>
    </div></div>
  </div>

  <WindPetals lang={lang} />
</section>

<script>
  import { wind, onTick, onState } from '../../scripts/wind';

  const svgs = [...document.querySelectorAll<SVGSVGElement>('svg.meadow')].map((svg) => {
    const vb = svg.viewBox.baseVal;
    return {
      svg, W: vb.width, H: vb.height, wide: svg.classList.contains('meadow--wide'),
      stems: [...svg.querySelectorAll<SVGGElement>('.m-stem')].map((g) => ({
        g, x: Number(g.dataset.x), h: Number(g.dataset.h), phase: Number(g.dataset.phase), a: 0, v: 0,
      })),
    };
  });
  let time = 0;
  onState(() => { if (wind.reduced) svgs.forEach((m) => m.stems.forEach((s) => s.g.removeAttribute('transform'))); });
  onTick((dt) => {
    time += dt;
    const strength = Math.min((wind.base + wind.gust) / 120, 2.2);
    const p = wind.pointer;
    for (const m of svgs) {
      const rect = m.svg.getBoundingClientRect();
      if (!rect.height) continue; // the composition for the other screen size
      // Map viewBox coordinates to the screen. Both use "slice": wide is aligned right, narrow is centred.
      const k = m.wide ? rect.height / m.H : Math.max(rect.width / m.W, rect.height / m.H);
      const left = m.wide ? rect.right - m.W * k : rect.left + (rect.width - m.W * k) / 2;
      for (const s of m.stems) {
        // The breeze travels as a wave from left to right across the meadow.
        const wave = Math.sin(time * 1.6 - (s.x / m.W) * 7 + s.phase * 0.3);
        const tall = 0.6 + (s.h / m.H) * 0.8;
        let push = 0;
        if (p.active) {
          const sx = left + s.x * k, sy = rect.bottom - s.h * k * 0.8;
          const dx = sx - p.x, dy = sy - p.y, d = Math.hypot(dx, dy), R = 170;
          // Cursor and touch effect: the stems part around the pointer.
          if (d < R) push = (dx / R) * (1 - d / R) * 18 + p.vx * 0.005 * (1 - d / R);
        }
        const target = wave * 3.2 * tall * (0.4 + strength * 0.6) + (wind.gust / 220) * 9 * tall + Math.max(-20, Math.min(20, push));
        s.v += (30 * (target - s.a) - 6 * s.v) * dt;
        s.a += s.v * dt;
        s.g.setAttribute('transform', `rotate(${s.a.toFixed(2)} ${s.x.toFixed(1)} ${m.H})`);
      }
    }
  });
</script>

<style>
  /* Phone: the meadow and the headline share the first screen; the rest follows. */
  .hero-c {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-areas: 'screen' 'more';
    grid-template-rows: clamp(30rem, calc(100svh - 8.75rem - env(safe-area-inset-bottom)), 46rem) auto;
  }
  .hero-c__meadow { grid-area: screen; position: relative; z-index: 0; overflow: hidden; }
  .meadow { display: block; width: 100%; height: 100%; }
  .meadow--wide { display: none; }

  .hero-c__top {
    grid-area: screen;
    align-self: end;
    position: relative;
    z-index: 2;
    padding-top: var(--space-9);
    padding-bottom: var(--space-4);
    /* Birch fade so the words sit on calm ground while the flowers rise above. */
    background: linear-gradient(to top, var(--birch) 64%, rgb(243 244 239 / 0.85) 82%, rgb(243 244 239 / 0));
  }
  .hero-c__top h1 { font-size: var(--step-4); }
  .hero-c__place {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--color-text-muted);
  }
  .hero-c__address a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: 600;
  }

  .hero-c__more { grid-area: more; position: relative; z-index: 2; padding-block: var(--space-4) var(--space-9); }
  .hero-c__lead { font-size: var(--step-1); line-height: 1.45; max-width: 34ch; }
  .hero-c__actions { margin-top: var(--space-5); }
  .hero-c__facts {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* Arrival: each flower grows up from the ground, rolling left to right. */
  @media (prefers-reduced-motion: no-preference) {
    .m-grow {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: m-grow 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d);
    }
  }
  @keyframes m-grow {
    from { transform: scale(0.7, 0.03); }
  }

  @media (min-width: 48rem) {
    .hero-c {
      display: block;
      min-height: min(48rem, calc(100svh - 4rem));
      padding-block: var(--space-9);
    }
    .hero-c__meadow { position: absolute; inset: 0; }
    .meadow--wide { display: block; }
    .meadow--narrow { display: none; }
    .hero-c__top { padding: 0; background: none; }
    .hero-c__top h1 { font-size: var(--step-5); }
    .hero-c__col { max-width: 34rem; }
    .hero-c__place { margin-top: var(--space-4); }
    .hero-c__more { padding-block: var(--space-3) 0; }
  }
</style>
