---
/**
 * The hero: a line-drawn meadow the wind rolls through as a wave; the cursor parts the stems.
 * Phone: the meadow fills the first screen, with the headline, place and address over its
 * bottom on a birch fade. The rest of the words follow just below the first screen.
 * Desktop: the meadow sits behind the words, low on the left and tall on the right.
 * Arrival: the flowers grow up from the ground in a left-to-right wave (CSS, plays once).
 * Still for prefers-reduced-motion.
 */
import { business } from '../../data/business';
import { t, routes, type Lang } from '../../i18n/utils';
import WindPetals from '../WindPetals.astro';
import { botanical } from '../../lib/botanical';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const place = business.locality?.[lang];
const address = [business.streetAddress, business.district].filter(Boolean).join(', ');

// Deterministic drawing kit so the meadow is the same on every build.
const { r, meadow } = botanical(7);
const INK = '#3e5b40';

// Desktop: low on the left where the words sit, tall on the right.
const DW = 1200, DH = 640;
// Tallest stems stop at about 78% of the height, leaving headroom for the blooms.
const wide = meadow(DW, DH, 34, (t) => (t < 0.56 ? r(0.03, 0.07) : r(0.42, 0.74) * (0.75 + t * 0.3)), 1);
// Phone: a tall portrait meadow that fills the first screen; heads fill the upper part.
const PW = 400, PH = 640;
const narrow = meadow(PW, PH, 18, (t) => 0.46 + Math.sin(t * Math.PI * 2.4 + 0.4) * 0.12 + r(0, 0.2), 1.3);
---

<section class="hero-c" aria-labelledby="hero-heading">
  <div class="hero-c__meadow" aria-hidden="true">
    {[{ cls: 'meadow--wide', W: DW, H: DH, stems: wide }, { cls: 'meadow--narrow', W: PW, H: PH, stems: narrow }].map((m) => (
      <div class:list={['meadow', m.cls]} data-meadow data-w={m.W} data-h={m.H}>
        {m.stems.map((s) => {
          const b = s.box;
          const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
          return (
            <div class="m-stem" data-x={s.x} data-h={s.h} data-phase={s.phase}
              style={`left:${pct(b.x, m.W)};top:${pct(b.y, m.H)};width:${pct(b.w, m.W)};height:${pct(b.h, m.H)};--ox:${pct(s.x - b.x, b.w)};--d:${s.delay}ms`}>
              <div class="m-grow">
                <svg viewBox={`${b.x.toFixed(1)} ${b.y.toFixed(1)} ${b.w.toFixed(1)} ${b.h.toFixed(1)}`} preserveAspectRatio="none" focusable="false" set:html={s.svg} />
              </div>
            </div>
          );
        })}
      </div>
    ))}
  </div>

  <div class="hero-c__top" data-wind-quiet>
    <div class="container"><div class="hero-c__col">
      <!-- TODO: client copy -->
      <h1 id="hero-heading">{t(lang, 'home.hero.heading')}</h1>
      <p class="hero-c__place">
        {place ? t(lang, 'site.taglineCity', { place }) : <>{t(lang, 'site.tagline')} <em class="todo">{t(lang, 'todo.city')}</em></>}
      </p>
      <p class="hero-c__address">
        {business.streetAddress && business.mapUrl
          ? <a href={business.mapUrl}>{address}<span class="visually-hidden">{t(lang, 'hero.facts.mapSuffix')}</span></a>
          : <em class="todo">{t(lang, 'todo.address')}</em>}
      </p>
    </div></div>
  </div>

  <div class="hero-c__more" data-wind-quiet>
    <div class="container"><div class="hero-c__col">
      <!-- TODO: client copy -->
      <p class="hero-c__lead">{t(lang, 'home.hero.leadShort')}</p>
      <p class="hero-c__actions"><a class="btn btn--primary" href={routes.shop[lang]}>{t(lang, 'cta.order')}</a></p>
      <ul class="hero-c__facts" aria-label={t(lang, 'hero.facts.label')}>
        <li>
          {t(lang, 'hero.facts.openToday')}{' '}
          {/* TODO: compute "Öppet idag till 18:30" from machine-readable hours once confirmed. */}
          <em class="todo">{t(lang, 'todo.hours')}</em>
        </li>
        <li>{t(lang, 'hero.facts.services')}</li>
      </ul>
    </div></div>
  </div>

  <WindPetals lang={lang} />
</section>

<script>
  import { wind, onTick, onState } from '../../scripts/wind';

  // Each stem is its own layer; rotating it with a CSS transform needs no repaint.
  const meadows = [...document.querySelectorAll<HTMLElement>('[data-meadow]')].map((box) => ({
    box, W: Number(box.dataset.w), H: Number(box.dataset.h),
    stems: [...box.querySelectorAll<HTMLElement>('.m-stem')].map((el) => ({
      el, x: Number(el.dataset.x), h: Number(el.dataset.h), phase: Number(el.dataset.phase), a: 0, v: 0, shown: 0,
    })),
  }));
  let time = 0;
  onState(() => { if (wind.reduced) meadows.forEach((m) => m.stems.forEach((s) => { s.el.style.transform = ''; s.shown = 0; })); });
  let carry = 0;
  onTick((frameDt) => {
    // On a struggling device, update the sway every other frame (with the time of both).
    carry += frameDt;
    if (wind.lowPower && wind.frame % 2) return;
    const dt = Math.min(carry, 0.05);
    carry = 0;
    time += dt;
    const strength = Math.min((wind.base + wind.gust) / 120, 2.2);
    const p = wind.pointer;
    for (const m of meadows) {
      const rect = m.box.getBoundingClientRect();
      if (!rect.height) continue; // the drawing for the other screen size
      const k = rect.height / m.H;
      for (const s of m.stems) {
        // The breeze travels as a wave from left to right across the meadow.
        const wave = Math.sin(time * 1.6 - (s.x / m.W) * 7 + s.phase * 0.3);
        const tall = 0.6 + (s.h / m.H) * 0.8;
        let push = 0;
        if (p.active) {
          const sx = rect.left + s.x * k, sy = rect.bottom - s.h * k * 0.8;
          const dx = sx - p.x, dy = sy - p.y, d = Math.hypot(dx, dy), R = 170;
          // Cursor and touch effect: the stems part around the pointer.
          if (d < R) push = (dx / R) * (1 - d / R) * 18 + p.vx * 0.005 * (1 - d / R);
        }
        const target = wave * 3.2 * tall * (0.4 + strength * 0.6) + (wind.gust / 220) * 9 * tall + Math.max(-20, Math.min(20, push));
        s.v += (30 * (target - s.a) - 6 * s.v) * dt;
        s.a += s.v * dt;
        if (Math.abs(s.a - s.shown) > 0.05) { s.el.style.transform = `rotate(${s.a.toFixed(2)}deg)`; s.shown = s.a; }
      }
    }
  });
</script>

<style>
  /* Phone: the meadow and the headline share the first screen; the rest follows. */
  .hero-c {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-areas: 'screen' 'more';
    grid-template-rows: clamp(30rem, calc(100svh - 8.75rem - env(safe-area-inset-bottom)), 46rem) auto;
  }
  /* The ground is a border so it spans the full width whatever the drawing's scale. */
  .hero-c__meadow { grid-area: screen; position: relative; z-index: 0; overflow: hidden; border-bottom: 1.5px solid #3e5b40; }
  /* Scale each drawing to the hero's height so the top is never cropped: narrow screens trim the
     sides (the phone drawing stays centred), wide screens keep the desktop drawing right-aligned. */
  .meadow { position: absolute; bottom: 0; height: 100%; max-width: none; }
  .meadow--narrow { left: 50%; transform: translateX(-50%); aspect-ratio: 400 / 640; }
  .meadow--wide {
    right: 0;
    aspect-ratio: 1200 / 640;
    /* On very wide screens the drawing starts mid-screen; fade its left edge so no flower is cut. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%);
    mask-image: linear-gradient(to right, transparent 0, #000 7%);
  }
  .m-stem { position: absolute; transform-origin: var(--ox) 100%; will-change: transform; }
  .m-grow { width: 100%; height: 100%; transform-origin: var(--ox) 100%; }
  .m-stem svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .meadow--wide { display: none; }

  .hero-c__top {
    grid-area: screen;
    align-self: end;
    position: relative;
    z-index: 2;
    padding-top: var(--space-9);
    padding-bottom: var(--space-4);
    /* Birch fade so the words sit on calm ground while the flowers rise above. */
    background: linear-gradient(to top, var(--birch) 64%, rgb(243 244 239 / 0.85) 82%, rgb(243 244 239 / 0));
  }
  .hero-c__top h1 { font-size: var(--step-4); }
  .hero-c__place {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--color-text-muted);
  }
  .hero-c__address a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: 600;
  }

  .hero-c__more { grid-area: more; position: relative; z-index: 2; padding-block: var(--space-4) var(--space-9); }
  .hero-c__lead { font-size: var(--step-1); line-height: 1.45; max-width: 34ch; }
  .hero-c__actions { margin-top: var(--space-5); }
  .hero-c__facts {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* Arrival: each flower grows up from the ground, rolling left to right. */
  @media (prefers-reduced-motion: no-preference) {
    .m-grow {
      animation: m-grow 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d);
    }
  }
  @keyframes m-grow {
    from { transform: scale(0.7, 0.03); }
  }

  @media (min-width: 48rem) {
    .hero-c {
      display: block;
      min-height: min(48rem, calc(100svh - 4rem));
      padding-block: var(--space-9);
    }
    .hero-c__meadow { position: absolute; inset: 0; }
    .meadow--wide { display: block; }
    .meadow--narrow { display: none; }
    .hero-c__top { padding: 0; background: none; }
    .hero-c__top h1 { font-size: var(--step-5); }
    .hero-c__col { max-width: 34rem; }
    .hero-c__place { margin-top: var(--space-4); }
    .hero-c__more { padding-block: var(--space-3) 0; }
  }
</style>
