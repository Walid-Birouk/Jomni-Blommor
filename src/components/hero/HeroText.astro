---
/** The hero's words: what, where, one button, and the find-us facts. Shared by every hero variant. */
import { business } from '../../data/business';
import { t, type Lang } from '../../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const place = business.locality?.[lang];
const address = [business.streetAddress, business.district].filter(Boolean).join(', ');
---

<div class="hero__text">
  <!-- TODO: client copy -->
  <h1 id="hero-heading">{t(lang, 'home.hero.heading')}</h1>
  <p class="hero__lead" data-wind-quiet>
    {place
      ? t(lang, 'home.hero.lead', { place })
      : <Fragment set:html={t(lang, 'home.hero.lead', { place: `<em class="todo">${t(lang, 'todo.city')}</em>` })} />}
  </p>
  <p class="hero__actions" data-wind-quiet>
    <a class="btn btn--primary" href="#kontakt">{t(lang, 'cta.order')}</a>
  </p>
  <ul class="hero__facts" data-wind-quiet aria-label={t(lang, 'hero.facts.label')}>
    <li>
      {business.streetAddress && business.mapUrl
        ? <a href={business.mapUrl}>{address}<span class="visually-hidden">{t(lang, 'hero.facts.mapSuffix')}</span></a>
        : <em class="todo">{t(lang, 'todo.address')}</em>}
    </li>
    <li>
      {t(lang, 'hero.facts.openToday')}{' '}
      {/* TODO: compute "Öppet idag till 18:30" from machine-readable hours once confirmed. */}
      <em class="todo">{t(lang, 'todo.hours')}</em>
    </li>
    <li>{t(lang, 'hero.facts.services')}</li>
  </ul>
</div>
<style>
  .hero__text { position: relative; z-index: 2; }
  .hero__lead {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--color-text-muted);
  }
  .hero__actions { margin-top: var(--space-5); }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .hero__facts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block: calc(var(--space-3) * -1);
    font-weight: 600;
  }
</style>
