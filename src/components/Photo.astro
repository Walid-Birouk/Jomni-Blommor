---
/**
 * A responsive photo. `sample` marks stock photos that stand in for the
 * client's own work: they get a small visible "Exempelbild" tag.
 * TODO: remove sample photos before launch (src/assets/stock/CREDITS.md).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  src: ImageMetadata;
  alt: string;
  lang: Lang;
  sizes: string;
  widths?: number[];
  sample?: boolean;
  ratio?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, lang, sizes, widths = [360, 540, 720, 960, 1280], sample = true, ratio, class: cls, eager = false } = Astro.props;
---

<figure class:list={['photo', cls]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="photo__img"
  />
  {sample && <span class="photo__tag" aria-hidden="true">{t(lang, 'photo.sample')}</span>}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-photo);
    background: var(--color-surface);
  }
  .photo :global(picture) { display: block; height: 100%; }
  .photo :global(.photo__img) {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio, 4 / 5);
    object-fit: cover;
  }
  .photo__tag {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    padding: 0.15rem 0.5rem;
    background: rgb(243 244 239 / 0.9);
    color: var(--ink);
    border-radius: 2px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }
</style>
