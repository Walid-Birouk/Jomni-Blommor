---
/**
 * Jomni Blommor logo (proposal until the client has a brand): a "J" drawn as a flower stem,
 * with a peony bloom as its dot and a single leaf. `mark` alone, or with the wordmark.
 * The favicon (public/favicon.svg) uses the same mark on a moss tile.
 */
interface Props { withName?: boolean; name?: string; class?: string; }
const { withName = true, name = 'Jomni Blommor', class: cls } = Astro.props;
const petals = [0, 1, 2, 3, 4].map((i) => {
  const a = ((i * 72 - 90) * Math.PI) / 180;
  return { x: (27 + Math.cos(a) * 5.28).toFixed(2), y: (12.5 + Math.sin(a) * 5.28).toFixed(2) };
});
---

<span class:list={['logo', cls]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path d="M27 19 V31.5 Q27 41 19.5 41 Q14.5 41 12.5 36.5" fill="none" stroke="var(--logo-stem, #3e5b40)" stroke-width="4.2" stroke-linecap="round" />
    <path d="M27 29 Q31 22.5 38.5 23.5 Q35.5 30.5 27 29 Z" fill="var(--logo-leaf, #cfdcc8)" stroke="var(--logo-stem, #3e5b40)" stroke-width="1.6" stroke-linejoin="round" />
    {petals.map((p) => <circle cx={p.x} cy={p.y} r="4.8" fill="var(--logo-petal, #e3a3b5)" stroke="var(--logo-stem, #3e5b40)" stroke-width="1.2" />)}
    <circle cx="27" cy="12.5" r="2.9" fill="#9e2f4f" stroke="var(--logo-stem, #3e5b40)" stroke-width="1.2" />
  </svg>
  {withName && <span class="logo__name">{name}</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.4rem; }
  .logo__mark { width: 2.1rem; height: 2.1rem; flex: none; margin-block: -0.2rem; }
  .logo__name {
    font-family: var(--font-display-stack);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
</style>
