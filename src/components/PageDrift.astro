---
/**
 * Below the hero, scrolling is the wind: a few petals blow across the page while
 * the visitor scrolls, then fade out. Motion only follows the visitor's own
 * scrolling, so it never runs on its own. Off for reduced motion or when the wind
 * is paused with the hero button.
 */
---

<canvas class="page-drift" aria-hidden="true"></canvas>

<script>
  import { wind } from '../scripts/wind';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.page-drift');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const COLORS = ['#9e2f4f', '#c25a78', '#e3a3b5', '#f1d5dc', '#8a9a7b'];
    type P = { x: number; y: number; vx: number; vy: number; s: number; rot: number; spin: number; flip: number; life: number; max: number; c: string };
    let ps: P[] = [];
    let raf = 0, last = 0, w = 0, h = 0, lastY = window.scrollY;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const spawn = (dy: number) => {
      const down = dy > 0;
      const p: P = {
        x: Math.random() * w * 0.6 - w * 0.1,
        y: down ? h + 10 - Math.random() * h * 0.3 : Math.random() * h * 0.3 - 10,
        vx: 60 + Math.random() * 80,
        vy: (down ? -1 : 1) * (40 + Math.random() * 60),
        s: 7 + Math.random() * 8,
        rot: Math.random() * 6.28, spin: (Math.random() - 0.5) * 3,
        flip: Math.random() * 6.28, life: 0, max: 1.8 + Math.random() * 1.4,
        c: COLORS[Math.floor(Math.random() * COLORS.length)],
      };
      ps.push(p);
    };

    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, w, h);
      ps = ps.filter((p) => (p.life += dt) < p.max);
      for (const p of ps) {
        p.x += p.vx * dt; p.y += p.vy * dt;
        p.vy += 12 * dt; p.vx *= Math.pow(0.7, dt);
        p.rot += p.spin * dt; p.flip += 3 * dt;
        const fade = Math.min(1, p.life * 4) * Math.min(1, (p.max - p.life) * 1.5);
        ctx.save();
        ctx.translate(p.x, p.y); ctx.rotate(p.rot);
        ctx.scale(1, Math.max(0.15, Math.abs(Math.cos(p.flip))));
        ctx.globalAlpha = 0.85 * fade;
        ctx.fillStyle = p.c;
        ctx.beginPath();
        ctx.moveTo(0, -p.s);
        ctx.bezierCurveTo(p.s * 0.9, -p.s * 0.6, p.s * 0.7, p.s * 0.7, 0, p.s);
        ctx.bezierCurveTo(-p.s * 0.7, p.s * 0.7, -p.s * 0.9, -p.s * 0.6, 0, -p.s);
        ctx.fill();
        ctx.restore();
      }
      raf = ps.length ? requestAnimationFrame(frame) : 0;
    };

    let budget = 0;
    window.addEventListener('scroll', () => {
      const dy = window.scrollY - lastY;
      lastY = window.scrollY;
      // The hero has its own wind; drift only once it is out of view.
      if (reduce.matches || wind.paused || wind.visible) return;
      budget += Math.min(Math.abs(dy), 120) / 70;
      while (budget >= 1 && ps.length < 18) { spawn(dy); budget -= 1; }
      if (ps.length && !raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
    }, { passive: true });
  }
</script>

<style>
  .page-drift {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 15;
    pointer-events: none;
  }
</style>
