---
/**
 * Home page content shared by / (sv) and /en/ (en), so both languages stay in sync.
 * TODO: client copy. All text here comes from src/i18n and src/content/services.
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { business } from '../data/business';
import { t, type Lang } from '../i18n/utils';
import WindPetals from './WindPetals.astro';
import Bouquet from './Bouquet.astro';
import shopImage from '../assets/placeholder/PLACEHOLDER-butiken.jpg';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const services = (await getCollection('services', (s) => s.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);

const place = business.locality?.[lang];
const hasContact = business.phoneE164 || business.email || business.mapUrl;
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="hero__text">
    <!-- TODO: client copy -->
    <h1 id="hero-heading">{t(lang, 'home.hero.heading')}</h1>
    <p class="hero__lead" data-wind-quiet>
      {place
        ? t(lang, 'home.hero.lead', { place })
        : <Fragment set:html={t(lang, 'home.hero.lead', { place: `<em class="todo">${t(lang, 'todo.city')}</em>` })} />}
    </p>
    <p class="hero__actions" data-wind-quiet>
      <a class="btn btn--primary" href="#kontakt">{t(lang, 'cta.order')}</a>
    </p>
    <ul class="hero__facts" data-wind-quiet aria-label={t(lang, 'hero.facts.label')}>
      <li>
        {business.streetAddress && business.mapUrl
          ? <a href={business.mapUrl}>{[business.streetAddress, business.district].filter(Boolean).join(', ')}<span class="visually-hidden">{t(lang, 'hero.facts.mapSuffix')}</span></a>
          : <em class="todo">{t(lang, 'todo.address')}</em>}
      </li>
      <li>
        {t(lang, 'hero.facts.openToday')}{' '}
        {/* TODO: compute "Öppet idag till 18:30" from machine-readable hours once confirmed. */}
        <em class="todo">{t(lang, 'todo.hours')}</em>
      </li>
      <li>{t(lang, 'hero.facts.services')}</li>
    </ul>
  </div>
  <div class="hero__media">
    <Bouquet />
  </div>
  <WindPetals lang={lang} />
</section>

<section id="tjanster" class="services" aria-labelledby="services-heading">
  <div class="container">
    <header class="services__head">
      <h2 id="services-heading">{t(lang, 'home.services.heading')}</h2>
      <p>{t(lang, 'home.services.intro')}</p>
    </header>
    <ul class="services__list">
      {services.map((s) => (
        <li class="service">
          <Picture
            src={s.data.image}
            alt={s.data.imageAlt}
            formats={['avif', 'webp']}
            widths={[360, 540, 720, 900]}
            sizes="(min-width: 48rem) 40vw, 100vw"
            class="service__img"
          />
          <div class="service__text">
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
            <a href="#kontakt">{t(lang, 'home.services.more', { service: s.data.title.toLowerCase() })}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="om-oss" class="about" aria-labelledby="about-heading">
  <div class="container about__inner">
    <Picture
      src={shopImage}
      alt={t(lang, 'home.about.alt')}
      formats={['avif', 'webp']}
      widths={[360, 540, 720, 960]}
      sizes="(min-width: 48rem) 50vw, 100vw"
      class="about__img"
    />
    <div class="about__text">
      <!-- TODO: client copy -->
      <h2 id="about-heading">{t(lang, 'home.about.heading')}</h2>
      <p>{t(lang, 'home.about.body')}</p>
    </div>
  </div>
</section>

<section id="kontakt" class="contact" aria-labelledby="contact-heading">
  <div class="container contact__inner">
    <div>
      <h2 id="contact-heading">{t(lang, 'home.contact.heading')}</h2>
      <p class="contact__body">{t(lang, 'home.contact.body')}</p>
      {hasContact ? (
        <p class="contact__actions">
          {business.phoneE164 && <a class="btn btn--primary" href={`tel:${business.phoneE164}`}>{t(lang, 'cta.call')}</a>}
          {business.email && <a class="btn btn--secondary" href={`mailto:${business.email}`}>{t(lang, 'home.contact.email.cta')}</a>}
          {business.mapUrl && <a class="btn btn--secondary" href={business.mapUrl}>{t(lang, 'cta.map')}</a>}
        </p>
      ) : (
        <p><em class="todo">{t(lang, 'home.contact.missing')}</em></p>
      )}
    </div>
    <dl class="contact__facts">
      <div>
        <dt>{t(lang, 'home.contact.address')}</dt>
        <dd>{business.streetAddress
          ? <>{business.streetAddress}, {business.postalCode} {business.city}</>
          : <em class="todo">{t(lang, 'todo.address')}</em>}</dd>
      </div>
      <div>
        <dt>{t(lang, 'home.contact.phone')}</dt>
        <dd>{business.phoneE164
          ? <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>
          : <em class="todo">{t(lang, 'todo.phone')}</em>}</dd>
      </div>
      <div>
        <dt>{t(lang, 'home.contact.email')}</dt>
        <dd>{business.email
          ? <a href={`mailto:${business.email}`}>{business.email}</a>
          : <em class="todo">{t(lang, 'todo.email')}</em>}</dd>
      </div>
      <div>
        <dt>{t(lang, 'home.contact.hours')}</dt>
        <dd>{business.openingHours
          ? business.openingHours.map((r) => <span class="contact__hour">{r[lang]} {r.hours}</span>)
          : <em class="todo">{t(lang, 'todo.hours')}</em>}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* Hero: text first on phones so what, where and the button sit above the fold. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--section-y);
  }
  .hero__lead {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--color-text-muted);
  }
  .hero__text { position: relative; z-index: 2; }
  .hero__actions { margin-top: var(--space-5); }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .hero__facts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block: calc(var(--space-3) * -1);
    font-weight: 600;
  }
  .hero__media { position: relative; z-index: 0; justify-self: stretch; }

  .services { padding-block: var(--section-y); border-top: 1px solid var(--color-border); }
  .services__head { max-width: var(--measure); }
  .services__head p { margin-top: var(--space-3); color: var(--color-text-muted); }
  .services__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-8);
  }
  .service { display: grid; gap: var(--space-4); }
  .service :global(.service__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-photo);
  }
  .service__text { max-width: 40ch; }
  .service__text p { margin-top: var(--space-2); }
  .service__text a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: var(--space-2);
    font-weight: 600;
  }

  .about { background: var(--color-surface); padding-block: var(--section-y); }
  .about__inner { display: grid; gap: var(--space-6); align-items: center; }
  .about :global(.about__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-photo);
  }
  .about__text { max-width: var(--measure); }
  .about__text p { margin-top: var(--space-4); }

  .contact { padding-block: var(--section-y); }
  .contact__inner { display: grid; gap: var(--space-7); }
  .contact__body { margin-top: var(--space-4); max-width: var(--measure); }
  .contact__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .contact__facts { display: grid; gap: var(--space-5); }
  .contact__facts dt { font-weight: 700; }
  .contact__facts dd { margin: var(--space-1) 0 0; }
  .contact__hour { display: block; font-variant-numeric: tabular-nums; }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }
    .hero__text { padding-bottom: var(--space-8); }

    .service {
      grid-template-columns: 5fr 4fr;
      align-items: center;
      gap: var(--space-8);
    }
    .service:nth-child(even) .service__text { order: -1; justify-self: end; }
    .service :global(.service__img) { aspect-ratio: 4 / 5; }

    .about__inner { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
    .contact__inner { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
</style>
