---
/** One shop product: photo (or line-drawn illustration), name, unit, price, and an order button. */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t, orderHref, type Lang } from '../../i18n/utils';
import { productArt, type ArtKind } from '../../lib/product-art';
interface Props { lang: Lang; product: CollectionEntry<'products'>['data']; }
const { lang, product } = Astro.props;
const name = product.name[lang];
const fmt = (v: number) => v.toLocaleString(lang === 'sv' ? 'sv-SE' : 'en-GB');
const price = product.priceMax
  ? t(lang, 'shop.from', { min: fmt(product.price), max: fmt(product.priceMax) })
  : t(lang, 'shop.price', { price: fmt(product.price) });
---

<li class="product" data-reveal>
  <div class:list={['product__media', { 'product__media--art': !product.image }]}>
    {product.image ? (
      <Picture src={product.image} alt={name} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 90vw" loading="lazy" class="product__img" />
    ) : (
      <>
        <svg viewBox="0 0 240 240" aria-hidden="true" focusable="false" set:html={productArt((product.art ?? 'plant') as ArtKind)} />
        <span class="product__note">{t(lang, 'shop.artNote')}</span>
      </>
    )}
  </div>
  <div class="product__body">
    <h3>{name}</h3>
    {product.unit && <p class="product__unit">{product.unit[lang]}</p>}
    <p class="product__price">{price}</p>
    <a class="btn btn--secondary product__order" href={orderHref(lang, 'bouquet', name)} aria-label={t(lang, 'shop.orderLabel', { product: name })}>{t(lang, 'shop.order')}</a>
  </div>
</li>

<style>
  .product {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--white);
    border-radius: var(--radius-control);
    overflow: hidden;
    box-shadow: 0 14px 30px -26px rgb(30 42 36 / 0.5);
  }
  .product__media { position: relative; aspect-ratio: 4 / 3; background: var(--white); }
  .product__media :global(picture) { display: block; height: 100%; }
  .product__media :global(.product__img) { width: 100%; height: 100%; object-fit: cover; }
  .product__media--art { background: var(--color-surface); display: grid; place-items: center; }
  .product__media--art svg { width: 72%; height: 92%; }
  .product__note { position: absolute; left: var(--space-2); bottom: var(--space-2); font-size: 0.72rem; color: var(--color-text-muted); }
  .product__body { display: grid; align-content: start; gap: var(--space-1); padding: var(--space-4) var(--space-4) var(--space-5); }
  .product h3 { font-size: var(--step-1); font-weight: 500; line-height: 1.3; }
  .product__unit { font-size: var(--step--1); color: var(--color-text-muted); }
  .product__price { margin-top: var(--space-1); font-weight: 700; font-variant-numeric: tabular-nums; }
  .product__order { justify-self: start; margin-top: var(--space-3); }
</style>
