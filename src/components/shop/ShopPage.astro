---
/**
 * The shop: real products and prices from the shop's Wolt menu.
 * Top: three ways to buy. A sticky category bar tracks where you are. Roses come in sizes
 * (one card per kind with a size picker); everything else is a compact card. "Lägg till"
 * collects products in a request that goes to the contact form in one go.
 * TODO: confirm range, prices and delivery details with the client.
 */
import { getCollection } from 'astro:content';
import { business } from '../../data/business';
import { t, routes, type Lang, type UiKey } from '../../i18n/utils';
import ProductCard from './ProductCard.astro';
import VariantCard from './VariantCard.astro';
import RequestBar from './RequestBar.astro';
import MeadowEdge from '../art/MeadowEdge.astro';
import FlowerStamp from '../art/FlowerStamp.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const all = (await getCollection('products')).map((p) => p.data).sort((a, b) => a.order - b.order);
const byGroup = (g: string) => all.filter((p) => p.group === g).sort((a, b) => (a.qty ?? 0) - (b.qty ?? 0));
const loose = (c: string) => all.filter((p) => p.category === c && !p.group);
const categories = ['roses', 'bunches', 'plants', 'pots'] as const;
const count = (c: string) => (c === 'roses' ? 2 + loose('roses').length : loose(c).length);
const label = (c: string) => t(lang, `shop.cat.${c}` as UiKey);
---

<section class="shop-intro" aria-labelledby="page-heading">
  <div class="container">
    <h1 id="page-heading">{t(lang, 'shop.heading')}</h1>
    <p class="shop-intro__lead">{t(lang, 'shop.lead')}</p>
    <h2 class="visually-hidden">{t(lang, 'shop.how.heading')}</h2>
    <ul class="ways">
      <li class="way">
        <svg class="way__icon" viewBox="0 0 24 32" aria-hidden="true"><path d="M12 1C6 1 1.5 5.4 1.5 11.2 1.5 19 12 31 12 31s10.5-12 10.5-19.8C22.5 5.4 18 1 12 1Z" fill="var(--peony)" stroke="var(--ink)" stroke-width="1.2"/><circle cx="12" cy="11.2" r="4" fill="var(--birch)"/></svg>
        <h3>{t(lang, 'shop.how.pickup.title')}</h3>
        <p>{t(lang, 'shop.how.pickup.text')}</p>
        <a href="#roses">{t(lang, 'shop.how.pickup.link')}</a>
      </li>
      {business.wolt && (
        <li class="way">
          <svg class="way__icon" viewBox="0 0 32 24" aria-hidden="true"><rect x="2" y="5" width="18" height="12" rx="2" fill="var(--sage-mist)" stroke="var(--ink)" stroke-width="1.4"/><path d="M20 9h5l4 4v4h-9" fill="var(--sage-mist)" stroke="var(--ink)" stroke-width="1.4" stroke-linejoin="round"/><circle cx="8" cy="19" r="2.6" fill="var(--birch)" stroke="var(--ink)" stroke-width="1.4"/><circle cx="24" cy="19" r="2.6" fill="var(--birch)" stroke="var(--ink)" stroke-width="1.4"/></svg>
          <h3>{t(lang, 'shop.how.wolt.title')}</h3>
          <p>{t(lang, 'shop.how.wolt.text')}</p>
          <a href={business.wolt}>{t(lang, 'shop.wolt')}</a>
        </li>
      )}
      <li class="way way--build">
        <FlowerStamp kind="cosmos" seed={91} class="way__stamp" />
        <h3>{t(lang, 'shop.how.build.title')}</h3>
        <p>{t(lang, 'shop.how.build.text')}</p>
        <a href={routes.builder[lang]}>{t(lang, 'cta.build')}</a>
      </li>
    </ul>
  </div>
</section>

<nav class="catbar" aria-label={t(lang, 'shop.categories')} data-catbar>
  <div class="container">
    <ul>
      {categories.map((c) => <li><a href={`#${c}`} data-cat={c}>{label(c)} <span>{count(c)}</span></a></li>)}
    </ul>
  </div>
</nav>

<section id="roses" class="cat" aria-labelledby="cat-roses" data-section>
  <div class="container">
    <h2 id="cat-roses" data-reveal>{label('roses')}</h2>
    <ul class="variants" data-reveal-group>
      <VariantCard lang={lang} group="rosor-brudsloja" title={t(lang, 'shop.groupRoses.brudsloja')} text={t(lang, 'shop.groupRoses.brudslojaText')} items={byGroup('rosor-brudsloja')} initial={5} />
      <VariantCard lang={lang} group="rosor-roda" title={t(lang, 'shop.groupRoses.roda')} text={t(lang, 'shop.groupRoses.rodaText')} items={byGroup('rosor-roda')} initial={3} />
    </ul>
    <ul class="products products--after" data-reveal-group>
      {loose('roses').map((p) => <ProductCard lang={lang} product={p} />)}
    </ul>
  </div>
</section>

{(['bunches', 'plants', 'pots'] as const).map((c, i) => (
  <section id={c} class:list={['cat', { 'cat--alt': i % 2 === 0 }]} aria-labelledby={`cat-${c}`} data-section>
    {i === 0 && <MeadowEdge seed={71} />}
    <div class="container">
      <h2 id={`cat-${c}`} data-reveal>{label(c)}</h2>
      <ul class="products" data-reveal-group>
        {loose(c).map((p) => <ProductCard lang={lang} product={p} />)}
      </ul>
    </div>
  </section>
))}

<section class="delivery" aria-labelledby="delivery-heading">
  <div class="container delivery__inner" data-reveal>
    <div>
      <h2 id="delivery-heading">{t(lang, 'shop.deliveryHeading')}</h2>
      <p>{t(lang, 'shop.deliveryText')} <em class="todo">{t(lang, 'todo.delivery')}</em></p>
      <p class="delivery__note">{t(lang, 'shop.priceNote')}</p>
    </div>
    <p class="delivery__actions">
      <a class="btn btn--primary" href={routes.builder[lang]}>{t(lang, 'cta.build')}</a>
      {business.wolt && <a class="btn btn--secondary" href={business.wolt}>{t(lang, 'shop.wolt')}</a>}
    </p>
  </div>
</section>

<RequestBar lang={lang} />

<script>
  // Highlight the category in view in the sticky bar.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-catbar] a')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  if (links.length && 'IntersectionObserver' in window) {
    const setCurrent = (id: string) => links.forEach((a) => {
      const on = a.dataset.cat === id;
      a.classList.toggle('is-current', on);
      if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    });
    // A section counts as current while it crosses a band near the top of the screen.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) setCurrent(e.target.id);
    }, { rootMargin: '-30% 0px -60% 0px' });
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .shop-intro { padding-block: var(--space-7) var(--space-6); }
  .shop-intro__lead { margin-top: var(--space-4); max-width: 44ch; font-size: var(--step-1); line-height: 1.5; color: var(--color-text-muted); }
  .ways { list-style: none; padding: 0; margin-top: var(--space-7); display: grid; gap: var(--space-4); }
  .way {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    background: var(--white);
    border-radius: var(--radius-control);
    box-shadow: 0 14px 30px -26px rgb(30 42 36 / 0.5);
  }
  .way > :not(.way__icon, :global(.way__stamp)) { grid-column: 2; }
  .way__icon { grid-row: 1 / span 3; width: 2rem; height: auto; margin-top: 2px; }
  .way :global(.way__stamp) { grid-row: 1 / span 3; width: 2.5rem; margin-top: -0.5rem; }
  .way h3 { font-size: var(--step-1); font-weight: 500; }
  .way p { margin-top: var(--space-1); font-size: var(--step--1); color: var(--color-text-muted); }
  .way a { display: inline-flex; align-items: center; min-height: var(--tap-min); font-weight: 600; }

  .catbar {
    position: sticky;
    top: var(--header-offset);
    z-index: 15;
    transition: top 320ms var(--ease-out);
    background: var(--color-bg);
    border-block: 1px solid var(--color-border);
  }
  /* Phone: one row that scrolls inside the bar (the page itself never scrolls sideways). */
  .catbar ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0 var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, #000 88%, transparent);
    mask-image: linear-gradient(to right, #000 88%, transparent);
  }
  .catbar ul::-webkit-scrollbar { display: none; }
  .catbar li { flex: none; }
  .catbar a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0 var(--space-3);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .catbar a:hover { color: var(--color-link); }
  .catbar a.is-current { color: var(--color-link); border-bottom-color: var(--peony); }
  .catbar span { display: none; font-size: var(--step--1); font-weight: 500; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }

  .cat { position: relative; padding-block: var(--space-8); scroll-margin-top: calc(var(--header-h) + 3.5rem); }
  .cat--alt { background: var(--color-surface); }
  .cat h2 { font-size: var(--step-4); line-height: var(--leading-tight); font-weight: 400; }
  .variants { list-style: none; padding: 0; margin-top: var(--space-6); display: grid; gap: var(--space-6); }
  .products {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .products--after { margin-top: var(--space-6); }

  .delivery { padding-block: var(--section-y) calc(var(--section-y) + 4rem); }
  .delivery__inner { display: grid; gap: var(--space-6); align-items: end; }
  .delivery h2 { font-size: var(--step-3); font-weight: 400; }
  .delivery p { margin-top: var(--space-3); max-width: var(--measure); }
  .delivery__note { font-size: var(--step--1); color: var(--color-text-muted); }
  .delivery__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @media (min-width: 40rem) {
    .catbar ul { gap: 0 var(--space-2); -webkit-mask-image: none; mask-image: none; flex-wrap: wrap; overflow: visible; }
    .catbar span { display: inline; }
    .products { grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr)); gap: var(--space-5); }
  }
  @media (min-width: 56rem) {
    .ways { grid-template-columns: repeat(3, 1fr); }
    .delivery__inner { grid-template-columns: 1.4fr 1fr; }
    .delivery__actions { justify-content: flex-end; }
  }
</style>
